{
  "name": "blackboard2openrouter",
  "version": "0.5.0",
  "description": "Generate OpenRouter API keys from Blackboard CSV exports",
  "type": "module",
  "author": "David Humphrey <david.andrew.humphrey@gmail.com>",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "blackboard2openrouter": "./dist/bin/cli.js"
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc",
    "clean": "rm -fr dist",
    "check": "pnpm format-check && pnpm lint && pnpm typecheck",
    "prettier": "prettier . --write",
    "format": "pnpm prettier",
    "prettier-check": "prettier . --check",
    "format-check": "pnpm prettier-check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "pi": "pi --provider openrouter --api-key $OPENROUTER_API_KEY --model $OPENROUTER_MODEL"
  },
  "license": "BSD-2-Clause",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "openrouter-key-manager": "^0.16.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.9.2",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.15.0"
}
